{
  "manifest_version": 3,
  "name": "Streamir: Local Qwen Voice",
  "short_name": "Streamir Voice",
  "version": "0.2.0",
  "description": "Generate expressive translated speech on your computer for the Streamir viewer, using a locally installed Qwen model.",
  "minimum_chrome_version": "138",
  "permissions": ["activeTab", "scripting", "nativeMessaging", "storage"],
  "background": {"service_worker": "background.js", "type": "module"},
  "action": {"default_popup": "popup.html", "default_title": "Streamir: Local Qwen Voice"},
  "options_page": "settings.html",
  "content_security_policy": {"extension_pages": "script-src 'self'; object-src 'none'; connect-src 'self'"}
}
